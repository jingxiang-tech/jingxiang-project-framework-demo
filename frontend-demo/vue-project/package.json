{
    "name": "vue-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "build:prod": "vue-tsc -b && vite build --mode production",
        "preview": "vite preview",
        "typecheck": "vue-tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\""
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "core-js",
            "esbuild",
            "vue-demi"
        ]
    },
    "dependencies": {
        "@ant-design/icons-vue": "^7.0.1",
        "@antv/g2": "^5.4.8",
        "@tanstack/vue-query": "^5.103.2",
        "ant-design-vue": "^4.2.6",
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mockjs": "^1.0.10",
        "@types/node": "^26.6.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "mockjs": "^1.1.0",
        "prettier": "^3.9.9",
        "sass-embedded": "^1.105.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vite-plugin-mock": "^3.0.2",
        "vue-tsc": "^3.3.11"
    }
}
